<details class="elyndor-skill-pools">
  <summary>{{localize "ELYNDOR.SkillPools.Summary"}}</summary>
  <table>
    <thead>
      <tr>
        <th>{{localize "ELYNDOR.SkillPools.Ability"}}</th>
        <th>{{localize "ELYNDOR.SkillPools.CareerAvailable"}}</th>
        <th>{{localize "ELYNDOR.SkillPools.RanksInMatchingSkills"}}</th>
      </tr>
    </thead>
    <tbody>
      {{#each restrictedRows}}
      <tr>
        <td>{{localize this.label}}</td>
        <td>{{this.careerTotal}}</td>
        <td>{{#if this.overCap}}{{this.careerTotal}} ({{this.overflow}}){{else}}{{this.ranksInMatchingSkills}}{{/if}}</td>
      </tr>
      {{/each}}
      <tr class="generic-row">
        <td>{{localize "ELYNDOR.SkillPools.Generic"}}</td>
        <td>{{genericCareerTotal}}</td>
        <td{{#if genericOver}} class="generic-over"{{/if}}>{{genericUsed}}</td>
      </tr>
    </tbody>
  </table>
  <p class="hint">{{localize "ELYNDOR.SkillPools.Hint"}}</p>
</details>
